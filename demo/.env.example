# The UAG demo site. Copy to .env and fill in every value marked "required".
# Generate secrets with: openssl rand -hex 32

# --- Public site -----------------------------------------------------------
# The domain the site is served at. Change this one value to move the site.
DEMO_DOMAIN=ai.onform.io
# Defaults to https://$DEMO_DOMAIN. Set it for another scheme or port (local runs).
DEMO_PUBLIC_URL=
# The host port the site listens on (plain HTTP; TLS is your load balancer's job),
# and the address it is bound to: this machine only, by default. Set DEMO_BIND to
# the private address your load balancer reaches, never a public one.
DEMO_PORT=8080
DEMO_BIND=127.0.0.1
# Reverse-proxy hops in front of the site, so visitor IPs are read correctly.
TRUST_PROXY=1
# Required. Signs the visitor cookie.
DEMO_SECRET=

# --- Spend protection -----------------------------------------------------
# Required. Cloudflare Turnstile, the human check in front of the live demos.
# To run without it, set DEMO_REQUIRE_TURNSTILE=false (not for a public site).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
DEMO_REQUIRE_TURNSTILE=true
# Units per UTC day across all visitors. A chat turn or an extraction costs 1,
# an application 2, and a chat turn 1 more per DEMO_TOKENS_PER_UNIT model tokens
# it used. 0 turns the cap off.
DEMO_DAILY_BUDGET=2000
DEMO_TOKENS_PER_UNIT=20000
# Units one network (an IPv4 address, or an IPv6 /64) may spend a day.
DEMO_DAILY_NETWORK_BUDGET=200
# Visitors' submissions are deleted after this many hours.
DEMO_RETENTION_HOURS=24

# --- Contact Us -------------------------------------------------------------
# The hosted Form.io form the Contact Us page renders.
CONTACT_FORM_URL=https://formio.form.io/contact

# --- The project ------------------------------------------------------------
# The demo's project, on Form.io's hosted service. Its name is its subdomain
# (FORMIO_PROJECT_NAME overrides it).
FORMIO_PROJECT_URL=https://uag.form.io
# Required. An API key of the project (its Settings, API Keys), used by the
# UAG, the site and the webhooks.
PROJECT_KEY=
# Where the project's webhooks call the UAG. Defaults to the site's relay,
# https://$DEMO_DOMAIN/webhooks/uag.
WEBHOOK_UAG_URL=

# --- The UAG ----------------------------------------------------------------
# A project on Form.io's hosted service needs no license. Self-hosted, the UAG
# reads LICENSE_KEY, with Form.io (see "Self-hosted only" below).
# Required. Signs the UAG's tokens.
UAG_JWT_SECRET=
# Seconds between the UAG's re-reads of the project.
PROJECT_TTL=300

# --- Engines ----------------------------------------------------------------
# Required. Shared by the UAG and the engine server, 32+ characters.
ENGINE_SERVER_KEY=
# Required. JEV (decisions) and Claude (values, and the chat).
TYPESAFE_API_KEY=
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CHAT_MODEL=claude-sonnet-5-5

# --- Flow viewer ------------------------------------------------------------
# Required. Protects the flow proxy's event stream on the private network.
FLOW_KEY=

# --- Self-hosted only (docker-compose.enterprise.yml) -------------------------
# Form.io Enterprise in the stack, instead of the hosted project. The setup job
# creates the project and installs PROJECT_KEY (then at least 24 random
# characters), and FORMIO_PROJECT_URL is ignored.
# Required there. The Form.io license, read by Form.io Enterprise and the UAG.
# For the UAG it must include the UAG (an online license with UAG servers, or
# an offline license with the "uag" option), and allow api-server:3000.
LICENSE_KEY=
# true when LICENSE_KEY is an offline (self-contained) license.
LICENSE_REMOTE=
# Deprecated. Only when LICENSE_KEY does not include the UAG: a license that
# does, and allows api-server:3000.
UAG_LICENSE=
# Required there. The portal administrator the setup job logs in as.
ADMIN_EMAIL=admin@example.com
ADMIN_PASS=
# Required there. Form.io's own secrets.
DB_SECRET=
FORMIO_JWT_SECRET=

# --- Images -----------------------------------------------------------------
# Built from this repository by `docker compose build`; or pull released ones.
UAG_IMAGE=formio/uag:demo
ENGINES_IMAGE=formio/uag-engines:demo
DEMO_IMAGE=formio/uag-demo:latest
