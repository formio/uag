# The UAG demo site. Copy to .env and fill in every value marked "required".
# Generate secrets with: openssl rand -hex 32

# --- The site ---------------------------------------------------------------
# The site's origin, the only one browsers may call the UAG from (its CORS).
DEMO_SITE_ORIGIN=http://localhost:8080
# The host port the UAG listens on (plain HTTP), and the address it is bound to:
# this machine only, by default.
UAG_PORT=3200
UAG_BIND=127.0.0.1
# Reverse-proxy hops in front of the UAG.
TRUST_PROXY=1
# The demo's rate limits (uag-module/index.js), replaced by JSON in the shape of
# agentApi.rateLimits: { "caller": { "chat": { "limit": 20 } }, "engine": {...} }.
DEMO_RATE_LIMITS=

# --- The project ------------------------------------------------------------
# Your project, on Form.io's hosted service, with the demo's forms already in it
# (module/project.json is their template; yarn workspace @formio/uag-demo setup
# imports it). Its name is its subdomain (FORMIO_PROJECT_NAME overrides it).
FORMIO_PROJECT_URL=https://your-project.form.io
# Required. An API key of the project (its Settings, API Keys), used by the UAG.
PROJECT_KEY=

# --- The UAG ----------------------------------------------------------------
# A project on Form.io's hosted service needs no license. Self-hosted, the UAG
# reads LICENSE_KEY, with Form.io (see "Self-hosted only" below).
# Required. Signs the UAG's tokens.
UAG_JWT_SECRET=
# Seconds between the UAG's re-reads of the project.
PROJECT_TTL=300

# --- Engines ----------------------------------------------------------------
# Required. JEV (decisions) and Claude (values, and the UAG's chat). They run
# inside the UAG, or on the engine server with docker-compose.split.yml.
TYPESAFE_API_KEY=
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Split only (docker-compose.split.yml) -----------------------------------
# The engine server as its own service.
# Required there. Shared by the UAG and the engine server, 32+ characters.
ENGINE_SERVER_KEY=

# --- Self-hosted only (docker-compose.enterprise.yml) -------------------------
# Form.io Enterprise in the stack, instead of the hosted project. The setup job
# creates the project and installs PROJECT_KEY (then at least 24 random
# characters), and FORMIO_PROJECT_URL is ignored.
# Required there. The Form.io license, read by Form.io Enterprise and the UAG.
# For the UAG it must include the UAG (an online license with UAG servers, or
# an offline license with the "uag" option), and allow api-server:3000.
LICENSE_KEY=
# true when LICENSE_KEY is an offline (self-contained) license.
LICENSE_REMOTE=
# Deprecated. Only when LICENSE_KEY does not include the UAG: a license that
# does, and allows api-server:3000.
UAG_LICENSE=
# Required there. Form.io Enterprise's ADMIN_KEY, which the setup job creates the
# project with. Generate it with: openssl rand -hex 32
FORMIO_ADMIN_KEY=
# Form.io's portal, off unless true (only "false" turns it off; "0" turns it on).
# The demo needs none. With it on, ADMIN_PASS is its administrator's password,
# which Form.io prints in its log when it creates the account.
PORTAL_ENABLED=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASS=
# Required there. Form.io's own secrets.
DB_SECRET=
FORMIO_JWT_SECRET=

# --- Images -----------------------------------------------------------------
# Built from this repository by `docker compose build`; or pull released ones.
UAG_IMAGE=formio/uag:demo
# Split only.
ENGINES_IMAGE=formio/uag-engines:demo
