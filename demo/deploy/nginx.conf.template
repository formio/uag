# The demo site as CloudFront served it: clean URLs, the 404 page, the security
# headers and the per-type Cache-Control. nginx fills ${DEMO_UAG_ORIGIN} and ${DEMO_CSP_PROJECT} in
# at start (the image's entrypoint). TLS ends at the load balancer.
map $uri $cache_control {
    default                     "public, max-age=86400";
    ~*\.(js|css)$               "public, max-age=31536000, immutable";
    ~*(\.(html|json)|/)$        "no-cache";
    ~^/[^.]*$                   "no-cache"; # clean URLs are pages
}

server {
    listen 8080;
    root /site;
    server_tokens off;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain application/xml;

    # Keep the Content-Security-Policy the same as lib/config.mjs's contentSecurityPolicy (demo/test checks).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' https://cdn.jsdelivr.net https://cdn.form.io ${DEMO_UAG_ORIGIN}; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdn.form.io ${DEMO_UAG_ORIGIN}; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net https://cdn.form.io ${DEMO_UAG_ORIGIN}; img-src 'self' data: blob: https:; connect-src 'self' ${DEMO_UAG_ORIGIN} https://*.form.io${DEMO_CSP_PROJECT}; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Cache-Control $cache_control always;

    error_page 404 /404.html;
    location = /404.html { internal; }

    if ($http_x_forwarded_proto = http) { return 301 https://$host$request_uri; }
    if ($request_method !~ ^(GET|HEAD)$) { return 405; }

    # /a/b and /a/b/ answer a/b/index.html.
    location / { try_files $uri $uri/index.html =404; }
}
