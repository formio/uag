# Run the demo on your machine against your own project on Form.io's hosted
# service. Copy to demo/.env.local (git ignores it), fill it in, then:
#
#   yarn install && yarn build
#   yarn demo:local          # http://localhost:8080
#
# See demo/README.md, "Run it against your own project".

# --- Your project -------------------------------------------------------------
# Required. Your project (or a stage of it), as https://<name>.form.io. It can be
# empty: yarn demo:local imports the demo's forms and actions into it. Not the
# deployed demo's own project, https://uag.form.io.
FORMIO_PROJECT_URL=https://your-project.form.io
# Required. An API key of the project: the project's Settings, API Keys.
PROJECT_KEY=
# The project's name, when it is not its subdomain.
FORMIO_PROJECT_NAME=

# --- Engines and the chat -----------------------------------------------------
# Required. Claude fills in values and runs the chat; JEV makes the decisions.
CLAUDE_API_KEY=
TYPESAFE_API_KEY=
CHAT_MODEL=claude-sonnet-5-5
CLAUDE_MODEL=claude-sonnet-5-5
# Other engines instead (see the Engines docs). Default: jev,claude
UAG_ENGINES=

# --- Webhooks (the Agentic Workflow demo) --------------------------------------
# The project's webhooks call this, and Form.io's hosted service must reach it
# from the internet: a tunnel to the site's port, ending in /webhooks/uag. For
# example, run `cloudflared tunnel --url http://localhost:8080` and set
# https://<the-name-it-prints>.trycloudflare.com/webhooks/uag. Empty, they call
# localhost, and applications stay "under review"; the other demos still work.
WEBHOOK_UAG_URL=

# --- Optional -------------------------------------------------------------------
# A hosted project needs no license: leave it empty. Against a self-hosted
# project, a Form.io license that includes the UAG and allows its endpoint.
LICENSE_KEY=
# off: do not import the demo's forms (they are already there, or you changed them).
DEMO_TEMPLATE_SYNC=
# Ports: the site, the UAG and the flow proxy.
DEMO_PORT=8080
UAG_PORT=3200
FLOW_PORT=3250
