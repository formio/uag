{
  "title": "Example: Fill a form from a description",
  "name": "exampleFillFromDescription",
  "path": "example-fill-from-description",
  "type": "form",
  "display": "form",
  "tags": ["uag"],
  "properties": {
    "description": "A general request: who sent it, when, what it is about, and the amount involved, filled in from the sender's own description."
  },
  "components": [
    {
      "type": "textarea",
      "key": "description",
      "label": "Describe your request",
      "placeholder": "Tell us what you need, in your own words.",
      "rows": 4,
      "input": true,
      "validate": { "required": true },
      "properties": { "uag": "fill", "uagField": "input" }
    },
    {
      "type": "textfield",
      "key": "name",
      "label": "Name",
      "input": true,
      "validate": { "required": true },
      "properties": { "uag": "fill" }
    },
    {
      "type": "email",
      "key": "email",
      "label": "Email",
      "input": true,
      "validate": { "required": true },
      "properties": { "uag": "fill" }
    },
    {
      "type": "select",
      "key": "topic",
      "label": "Topic",
      "input": true,
      "dataSrc": "values",
      "data": {
        "values": [
          { "label": "Question", "value": "question" },
          { "label": "Problem", "value": "problem" },
          { "label": "Request", "value": "request" },
          { "label": "Feedback", "value": "feedback" }
        ]
      },
      "validate": { "required": true },
      "properties": { "uag": "fill" }
    },
    {
      "type": "day",
      "key": "date",
      "label": "Date it happened",
      "input": true,
      "properties": { "uag": "fill" }
    },
    {
      "type": "currency",
      "key": "amount",
      "label": "Amount involved",
      "currency": "USD",
      "input": true,
      "properties": { "uag": "fill" }
    },
    {
      "type": "button",
      "key": "submit",
      "label": "Submit",
      "action": "submit",
      "input": true
    }
  ]
}
