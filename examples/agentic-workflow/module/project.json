{
  "title": "UAG Agentic Workflow Example",
  "version": "2.0.0",
  "name": "uag-agentic-workflow",
  "roles": {
    "administrator": {
      "title": "Administrator",
      "description": "A role for Administrative Users.",
      "admin": true,
      "default": false
    },
    "authenticated": {
      "title": "Authenticated",
      "description": "Prospective students with a verified account.",
      "admin": false,
      "default": false
    },
    "anonymous": {
      "title": "Anonymous",
      "description": "A role for Anonymous Users.",
      "admin": false,
      "default": true
    }
  },
  "forms": {
    "application": {
      "title": "College Application",
      "type": "form",
      "name": "application",
      "path": "application",
      "display": "wizard",
      "tags": [
        "uag"
      ],
      "settings": {},
      "components": [
        {
          "type": "panel",
          "key": "personalInformation",
          "title": "Personal Information",
          "input": false,
          "tableView": false,
          "components": [
            {
              "type": "textfield",
              "key": "firstName",
              "label": "First Name",
              "validate": {
                "required": true
              },
              "input": true,
              "tableView": true
            },
            {
              "type": "textfield",
              "key": "lastName",
              "label": "Last Name",
              "validate": {
                "required": true
              },
              "input": true,
              "tableView": true
            },
            {
              "type": "email",
              "key": "email",
              "label": "Contact Email",
              "placeholder": "Enter your email address",
              "validate": {
                "required": true
              },
              "input": true,
              "tableView": true
            },
            {
              "type": "datetime",
              "key": "dateOfBirth",
              "label": "Date of Birth",
              "format": "yyyy-MM-dd",
              "enableTime": false,
              "validate": {
                "required": true
              },
              "input": true,
              "tableView": true,
              "widget": {
                "type": "calendar",
                "displayInTimezone": "viewer",
                "locale": "en",
                "useLocaleSettings": false,
                "allowInput": true,
                "mode": "single",
                "enableTime": false,
                "noCalendar": false,
                "format": "yyyy-MM-dd",
                "hourIncrement": 1,
                "minuteIncrement": 1,
                "time_24hr": false,
                "minDate": null,
                "maxDate": null
              }
            },
            {
              "type": "phoneNumber",
              "key": "phone",
              "label": "Phone Number",
              "input": true,
              "tableView": true
            },
            {
              "type": "textarea",
              "key": "address",
              "label": "Home Address",
              "autoExpand": false,
              "input": true,
              "tableView": false
            }
          ],
          "label": "Panel"
        },
        {
          "type": "panel",
          "key": "academics",
          "title": "Academics",
          "input": false,
          "tableView": false,
          "components": [
            {
              "type": "textfield",
              "key": "highSchool",
              "label": "High School",
              "validate": {
                "required": true
              },
              "input": true,
              "tableView": true
            },
            {
              "type": "number",
              "key": "gpa",
              "label": "GPA",
              "validate": {
                "required": true,
                "min": 0,
                "max": 5
              },
              "input": true,
              "tableView": true
            },
            {
              "type": "select",
              "key": "testType",
              "label": "Standardized Test",
              "data": {
                "values": [
                  {
                    "label": "SAT",
                    "value": "sat"
                  },
                  {
                    "label": "ACT",
                    "value": "act"
                  },
                  {
                    "label": "None",
                    "value": "none"
                  }
                ]
              },
              "defaultValue": "none",
              "input": true,
              "tableView": true
            },
            {
              "type": "number",
              "key": "testScore",
              "label": "Test Score",
              "input": true,
              "tableView": true
            }
          ],
          "label": "Panel"
        },
        {
          "type": "panel",
          "key": "activitiesEssays",
          "title": "Activities & Essays",
          "input": false,
          "tableView": false,
          "components": [
            {
              "type": "textarea",
              "key": "extracurriculars",
              "label": "Extracurricular Activities & Impact",
              "autoExpand": false,
              "input": true,
              "tableView": false
            },
            {
              "type": "textarea",
              "key": "leadership",
              "label": "Leadership & Initiative",
              "autoExpand": false,
              "input": true,
              "tableView": false
            },
            {
              "type": "textarea",
              "key": "service",
              "label": "Service Orientation",
              "autoExpand": false,
              "input": true,
              "tableView": false
            },
            {
              "type": "textarea",
              "key": "essay",
              "label": "Application Essay",
              "autoExpand": false,
              "validate": {
                "required": true
              },
              "input": true,
              "tableView": false
            }
          ],
          "label": "Panel"
        },
        {
          "type": "panel",
          "key": "workflow",
          "title": "Workflow Status",
          "input": false,
          "tableView": false,
          "components": [
            {
              "type": "select",
              "key": "status",
              "label": "Status",
              "data": {
                "values": [
                  {
                    "label": "Submitted",
                    "value": "submitted"
                  },
                  {
                    "label": "Declined",
                    "value": "declined"
                  },
                  {
                    "label": "Accepted",
                    "value": "accepted"
                  },
                  {
                    "label": "Scholarship Evaluation",
                    "value": "scholarshipEvaluation"
                  },
                  {
                    "label": "Scholarship Granted",
                    "value": "scholarshipGranted"
                  }
                ]
              },
              "defaultValue": "submitted",
              "input": true,
              "tableView": true,
              "properties": {
                "uag": "admissions"
              }
            },
            {
              "type": "select",
              "key": "decision",
              "label": "Decision",
              "data": {
                "values": [
                  {
                    "label": "Declined",
                    "value": "declined"
                  },
                  {
                    "label": "Accepted",
                    "value": "accepted"
                  },
                  {
                    "label": "Accepted with Scholarship",
                    "value": "acceptedWithScholarship"
                  }
                ]
              },
              "input": true,
              "tableView": true,
              "properties": {
                "uag": "admissions"
              }
            },
            {
              "type": "select",
              "key": "awardLevel",
              "label": "Scholarship Award",
              "data": {
                "values": [
                  {
                    "label": "Full Ride",
                    "value": "fullRide"
                  },
                  {
                    "label": "Paid Room & Board + 25% Discount",
                    "value": "roomBoard25"
                  },
                  {
                    "label": "Supplemental Scholarship (25% Discount)",
                    "value": "supplemental25"
                  },
                  {
                    "label": "$1000 Reward",
                    "value": "reward1000"
                  }
                ]
              },
              "input": true,
              "tableView": true,
              "properties": {
                "uag": "finance"
              }
            }
          ],
          "label": "Workflow Status"
        },
        {
          "type": "panel",
          "key": "agentAdmissionsReview",
          "title": "Admissions Review (Agent)",
          "input": false,
          "tableView": false,
          "properties": {
            "uag": "admissions"
          },
          "components": [
            {
              "html": "<h4>Admissions Assessment Criteria (Agent)</h4>\n<p>You are an admissions reviewer for the college. Analyze this application submission &mdash; academics (high school, GPA, standardized testing), extracurricular activities, leadership, service, and the application essay &mdash; and score the applicant.</p>\n<p>Score each of the six criteria from 1 (poor) to 10 (exceptional):</p>\n<ul>\n<li><code>academicsScore</code> &mdash; GPA and academic rigor. 4.0 GPA = 9-10, 3.5-3.9 = 7-8, below 3.0 = 4 or less.</li>\n<li><code>testingScore</code> &mdash; SAT 1500+/ACT 33+ = 9-10, SAT 1300-1499/ACT 28-32 = 7-8, SAT below 1100/ACT below 22 = 4 or less. If <code>testType</code> is \"none\", set this to 5.</li>\n<li><code>extracurricularScore</code> &mdash; depth and impact of activities.</li>\n<li><code>leadershipScore</code> &mdash; initiative, founding or leading things.</li>\n<li><code>serviceScore</code> &mdash; consistency and sincerity of community service.</li>\n<li><code>essaysScore</code> &mdash; specificity, self-awareness, and quality of writing.</li>\n</ul>\n<p>Compute the average of the six scores, rounded to one decimal, into <code>overallScore</code>.</p>\n<p>Round that average to the nearest whole number and set <code>decision</code> and <code>status</code> together:</p>\n<ul>\n<li>5 and below &rarr; <code>decision</code> \"declined\", <code>status</code> \"declined\"</li>\n<li>6 to 8 &rarr; <code>decision</code> \"accepted\", <code>status</code> \"accepted\"</li>\n<li>9 to 10 &rarr; <code>decision</code> \"acceptedWithScholarship\", <code>status</code> \"scholarshipEvaluation\"</li>\n</ul>\n<p>Write a 2-4 sentence justification of your scoring and decision into <code>agentRationale</code>. Do not modify any field the applicant filled out.</p>",
              "label": "Admissions Criteria",
              "refreshOnChange": false,
              "key": "admissionsCriteria",
              "properties": {
                "uag": "admissions",
                "uagField": "criteria"
              },
              "type": "content",
              "input": false,
              "tableView": false
            },
            {
              "type": "number",
              "key": "academicsScore",
              "label": "Academics (1-10)",
              "validate": {
                "min": 1,
                "max": 10
              },
              "input": true,
              "tableView": true
            },
            {
              "type": "number",
              "key": "testingScore",
              "label": "Testing (1-10)",
              "validate": {
                "min": 1,
                "max": 10
              },
              "input": true,
              "tableView": true
            },
            {
              "type": "number",
              "key": "extracurricularScore",
              "label": "Extracurricular & Impact (1-10)",
              "validate": {
                "min": 1,
                "max": 10
              },
              "input": true,
              "tableView": true
            },
            {
              "type": "number",
              "key": "leadershipScore",
              "label": "Leadership & Initiative (1-10)",
              "validate": {
                "min": 1,
                "max": 10
              },
              "input": true,
              "tableView": true
            },
            {
              "type": "number",
              "key": "serviceScore",
              "label": "Service Orientation (1-10)",
              "validate": {
                "min": 1,
                "max": 10
              },
              "input": true,
              "tableView": true
            },
            {
              "type": "number",
              "key": "essaysScore",
              "label": "Essays (1-10)",
              "validate": {
                "min": 1,
                "max": 10
              },
              "input": true,
              "tableView": true
            },
            {
              "type": "number",
              "key": "overallScore",
              "label": "Overall Score",
              "input": true,
              "tableView": true
            },
            {
              "type": "textarea",
              "key": "agentRationale",
              "label": "Assessment Rationale",
              "autoExpand": false,
              "input": true,
              "tableView": false
            }
          ],
          "label": "Panel"
        },
        {
          "type": "panel",
          "key": "agentScholarshipReview",
          "title": "Scholarship Review (Agent)",
          "input": false,
          "tableView": false,
          "properties": {
            "uag": "finance"
          },
          "components": [
            {
              "type": "content",
              "key": "financeCriteria",
              "label": "Scholarship Criteria",
              "input": false,
              "tableView": false,
              "html": "<h4>Scholarship Award Criteria (Agent)</h4>\n<p>You are the scholarship (finance) administrator. You only evaluate applicants whose <code>decision</code> is \"acceptedWithScholarship\". Review the application together with the admissions scores and rationale, then select the award.</p>\n<p>Set <code>awardLevel</code>:</p>\n<ul>\n<li>\"fullRide\" &mdash; exceptional applicant: <code>overallScore</code> 9.7 or higher, or an extraordinary singular achievement.</li>\n<li>\"roomBoard25\" &mdash; great applicant: <code>overallScore</code> 9.4 to 9.6.</li>\n<li>\"supplemental25\" &mdash; good applicant: <code>overallScore</code> 9.0 to 9.3.</li>\n<li>\"reward1000\" &mdash; average scholarship-track applicant: below 9.0.</li>\n</ul>\n<p>Set <code>status</code> to \"scholarshipGranted\".</p>\n<p>Write a 1-3 sentence justification into <code>financeRationale</code>. Do not modify the admissions scores.</p>",
              "properties": {
                "uag": "finance",
                "uagField": "criteria"
              }
            },
            {
              "type": "textarea",
              "key": "financeRationale",
              "label": "Award Rationale",
              "autoExpand": false,
              "input": true,
              "tableView": false
            }
          ],
          "label": "Panel"
        }
      ],
      "access": [
        {
          "type": "create_own",
