    "sum": {
      "title": "Sum",
      "type": "form",
      "name": "sum",
      "path": "sum",
      "display": "form",
      "tags": [
        "uag"
      ],
      "components": [
        {
          "type": "number",
          "key": "a",
          "label": "A",
          "input": true,
          "validate": {
            "required": true
          },
          "tableView": true
        },
        {
          "type": "number",
          "key": "b",
          "label": "B",
          "input": true,
          "validate": {
            "required": true
          },
          "tableView": true
        },
        {
          "type": "content",
          "key": "criteria",
          "label": "Criteria",
          "input": false,
          "html": "<p><strong>Agent instructions:</strong> This form has two numeric inputs: <code>a</code> and <code>b</code>. Compute the numeric total of <code>a</code> plus <code>b</code> and place that value in the <code>sum</code> field. Set <code>sum</code> to exactly the numeric sum \u2014 no rounding, no formatting, no text. Do not modify <code>a</code> or <code>b</code>.</p>",
          "properties": {
            "uag": "agent",
            "uagField": "criteria"
          }
        },
        {
          "type": "number",
          "key": "sum",
          "label": "Sum",
          "input": true,
          "disabled": true,
          "tableView": true,
          "properties": {
            "uag": "agent"
          }
        },
        {
          "type": "button",
          "key": "submit",
          "label": "Submit",
          "action": "submit",
          "input": true,
          "theme": "primary"
        }
      ],
      "access": [
        {
          "type": "read_all",
          "roles": [
            "administrator",
            "authenticated",
            "anonymous"
          ]
        }
      ],
      "submissionAccess": [],
      "submissionRevisions": "",
      "revisions": "original",
      "esign": {},
      "pdfComponents": []
    }
