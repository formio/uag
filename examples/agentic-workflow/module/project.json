  "resources": {},
  "actions": {
    "application:save": {
      "title": "Save Submission",
      "name": "save",
      "form": "application",
      "priority": 10,
      "method": [
        "create",
        "update"
      ],
      "handler": [
        "before"
      ]
    },
    "application:webhook": {
      "title": "Agent: Admissions Evaluation (Webhook)",
      "name": "webhook",
      "form": "application",
      "priority": 0,
      "method": [
        "create"
      ],
      "handler": [
        "after"
      ],
      "settings": {
        "method": "post",
        "url": "http://formio-uag-claude:3300/agent/claude/agent_provide_data",
        "block": false,
        "headers": [
          {
            "header": "x-token",
            "value": "REPLACE_WITH_PROJECT_KEY"
          }
        ],
        "transform": "payload = {formName: 'application', submissionId: payload.submission._id, persona: 'admissions'};"
      }
    },
    "application:webhookFinance": {
      "title": "Agent: Scholarship Evaluation (Webhook)",
      "name": "webhook",
      "form": "application",
      "priority": 0,
      "method": [
        "update"
      ],
      "handler": [
        "after"
      ],
      "settings": {
        "method": "post",
        "url": "http://formio-uag-claude:3300/agent/claude/agent_provide_data",
        "block": false,
        "headers": [
          {
            "header": "x-token",
            "value": "REPLACE_WITH_PROJECT_KEY"
          }
        ],
        "transform": "payload = {formName: 'application', submissionId: payload.submission._id, persona: 'finance'};"
      },
      "condition": {
        "conjunction": "all",
        "conditions": [
          {
            "component": "status",
            "operator": "isEqual",
            "value": "scholarshipEvaluation"
          }
        ],
        "custom": ""
      }
    },
    "sum:save": {
      "title": "Save Submission",
      "name": "save",
      "form": "sum",
      "priority": 10,
      "method": [
        "create",
        "update"
      ],
      "handler": [
        "before"
      ]
    },
    "sum:webhook": {
      "title": "Agent (Webhook)",
      "name": "webhook",
      "form": "sum",
      "priority": 0,
      "method": [
        "create"
      ],
      "handler": [
        "after"
      ],
      "settings": {
        "method": "post",
        "url": "http://formio-uag-claude:3300/agent/claude/agent_provide_data",
        "block": false,
        "headers": [
          {
            "header": "x-token",
            "value": "REPLACE_WITH_PROJECT_KEY"
          }
        ],
        "transform": "payload = {formName: 'sum', submissionId: payload.submission._id, persona: 'agent'};"
      }
    }
  },
