# Copy this file to .env and fill in the three keys below.
# Docker Compose loads .env automatically from this directory.

# Anthropic API key for the agent itself. https://console.anthropic.com
CLAUDE_API_KEY=sk-ant-api03-YOUR-KEY-HERE

# Form.io Enterprise Server license. Contact support@form.io for a trial.
LICENSE_KEY=YOUR-FORMIO-LICENSE-KEY

# Uncomment when LICENSE_KEY above is an offline license — a long JWT rather
# than a short key. Tells the server to validate it locally instead of calling
# out to the Form.io license server.
# LICENSE_REMOTE=true

# UAG license. Contact support@form.io for a trial.
UAG_LICENSE=YOUR-UAG-LICENSE-KEY

# Project API key. Leave this empty — ./setup.sh creates the project and
# writes the key it generates back into this file.
PROJECT_KEY=
