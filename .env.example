PORT=3300
DEBUG=formio:*
PROJECT=http://localhost:3000
PROJECT_RETRIES=5
PROJECT_RETRY_DELAY=5000
ADMIN_KEY=CHANGEME
JWT_SECRET=CHANGEME
JWT_EXPIRE_TIME=2592000
LOGIN_FORM=http://localhost:3000/user/login
# Behind a reverse proxy: TRUST_PROXY=1
# Anonymous use of agent operations on forms with uagAnonymous (per minute; 0 turns it off):
# AGENT_ANONYMOUS_RATE_LIMIT=10
# AGENT_ANONYMOUS_TOTAL_RATE_LIMIT=100
# The UAG's own database (optional, needs a license): MONGO=mongodb://localhost:27017 and UAG_DATABASE=uag
# Remote MCP sign-in (needs MONGO): MCP_OAUTH=true
# The Form.io license. A UAG run from this checkout uses it, and so does
# yarn demo:start <port> (the whole demo, self-hosted on Form.io Enterprise),
# for Form.io Enterprise and for the UAG.
LICENSE_KEY=
# yarn demo:start <port> also reads (see demo/README.md):
# UAG_LICENSE=<the UAG's own license, when LICENSE_KEY does not include the UAG>
# CLAUDE_API_KEY=...
# TYPESAFE_API_KEY=...
# Optional; each is random for every start when not set, and the portal sign-in is printed:
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASS=
# PROJECT_KEY= DB_SECRET= FORMIO_JWT_SECRET= UAG_JWT_SECRET= PORTAL_SECRET= ENGINE_SERVER_KEY= FLOW_KEY= DEMO_SECRET=
