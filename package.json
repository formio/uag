{
  "name": "@formio/uag",
  "version": "2.0.0-rc.1",
  "mcpName": "io.form/formio-uag",
  "description": "The Form.io Universal Agent Gateway (UAG).",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "lib",
    "bin"
  ],
  "workspaces": [
    "engines/*",
    "packages/*",
    "demo"
  ],
  "scripts": {
    "clean": "rm -rf lib",
    "build:ts": "tsc",
    "build:copy-templates": "mkdir -p lib/templates && cp src/templates/*.md lib/templates/",
    "build": "npm run clean && npm run build:ts && npm run build:copy-templates",
    "prepublishOnly": "npm run build && node scripts/check-release.mjs",
    "build:docker": "docker build -t formio/uag$(node -p \"require('./package.json').version.includes('-rc.') ? ':rc' : ''\") --platform=linux/amd64 .",
    "test": "tsc --noEmit -p tsconfig.test.json && mocha --no-node-snapshot",
    "test:e2e": "mocha --config .mocharc.e2e.json",
    "release": "node scripts/release.mjs",
    "release:version": "node scripts/set-version.mjs",
    "dev": "tsx --no-node-snapshot index.js",
    "demo:dev": "node --no-node-snapshot demo/scripts/dev.mjs",
    "demo:local": "node --no-node-snapshot demo/scripts/local.mjs",
    "demo:start": "node --no-node-snapshot demo/scripts/start.mjs",
    "demo:record": "node --no-node-snapshot demo/recordings/record.mjs",
    "start": "node --no-node-snapshot index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/formio/uag.git"
  },
  "author": "Form.io Developers",
  "license": "MIT",
  "dependencies": {
    "@formio/appserver": "^2.24.1",
    "@formio/appserver-core": "^2.24.1",
    "@formio/core": "2.9.0",
    "@formio/uag-sdk": "^2.0.0-rc.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "cors": "^2.8.6",
    "debug": "^4.4.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "mongodb": "^7.7.0",
    "node-cache": "^5.1.2",
    "node-html-markdown": "^2.0.0",
    "zod": "^4.6.7"
  },
  "resolutions": {
    "tar": ">=7.5.12",
    "minimatch": ">=10.2.4",
    "brace-expansion": ">=5.0.1",
    "diff": ">=8.0.3",
    "serialize-javascript": ">=7.0.4",
    "dompurify": ">=3.3.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@formio/js": "5.6.1",
    "@types/chai": "^5.2.3",
    "@types/cors": "^2.8.19",
    "@types/debug": "^4.1.13",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.27",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "chai": "^6.3.0",
    "jsdom": "30.1.2",
    "mocha": "^12.0.3",
    "mongodb-memory-server": "^11.3.0",
    "playwright": "1.64.1",
    "supertest": "^7.3.1",
    "terser": "^5.51.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "packageManager": "yarn@4.17.1",
  "dependenciesMeta": {
    "esbuild": {
      "built": true
    },
    "isolated-vm": {
      "built": true
    }
  },
  "bin": {
    "uag": "bin/uag.js",
    "uag-eval": "bin/uag-eval.js"
  }
}
