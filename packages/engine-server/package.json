    "research.js",
    "bin",
    "README.md"
  ],
  "scripts": {
    "test": "mocha"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formio/uag.git",
    "directory": "packages/engine-server"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
